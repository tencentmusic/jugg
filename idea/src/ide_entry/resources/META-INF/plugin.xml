<idea-plugin
    require-restart="true"
>
    <id>com.sickworm.intellij.jugg</id>
    <name>Jugg</name>
    <vendor email="ch.operation@gmail.com" url="https://sickworm.com">sickworm</vendor>
    <idea-version since-build="211.7628.21" />

    <description><![CDATA[
<p>Fast incremental compilation and deployment for Android projects.</p>
<p>Jugg compiles changed Android sources and resources outside the normal Gradle build, then deploys compatible changes to a running app.</p>
<h3>Highlights</h3>
<ul>
  <li>Incremental compilation for Kotlin, Java, Android resources, and manifests.</li>
  <li>Code swap, resource deployment, and Gradle fallback when incremental deployment is unavailable.</li>
  <li>Android Studio and IntelliJ IDEA integration, including Android test support and project-level controls.</li>
</ul>
<h3>Important limitations</h3>
<p>Jugg does not replace the complete Gradle pipeline. Changes that require Gradle processing, such as build-script changes or unsupported annotation and bytecode processing, require a Gradle build.</p>
    ]]></description>

    <depends>org.jetbrains.android</depends>
    <depends optional="true" config-file="androidstudio-config.xml">com.intellij.modules.androidstudio</depends>

    <applicationListeners>
        <listener
                class="com.sickworm.intellij.jugg.ide.PluginLoadListener"
                topic="com.intellij.ide.plugins.DynamicPluginListener"
        />
    </applicationListeners>

    <projectListeners>
        <listener
                class="com.sickworm.intellij.jugg.ide.JuggProjectManagerListener"
                topic="com.intellij.openapi.project.ProjectManagerListener"
        />
        <!-- won't call back after Android Studio Giraffe -->
        <listener
                class="com.sickworm.intellij.jugg.ide.JuggGradleSyncListener"
                topic="com.android.tools.idea.gradle.project.sync.GradleSyncListener"
        />
        <listener
                class="com.sickworm.intellij.jugg.ide.JuggGradleSyncWithRootListener"
                topic="com.android.tools.idea.gradle.project.sync.GradleSyncListenerWithRoot"
        />
    </projectListeners>

    <extensions defaultExtensionNs="com.intellij">
        <configurationType
                id="jugg.JuggConfigurationType"
                implementation="com.sickworm.intellij.jugg.ide.JuggConfigurationType"
        />
        <configurationType
                id="jugg.JuggAndroidTestConfigurationType"
                implementation="com.sickworm.intellij.jugg.ide.JuggAndroidTestConfigurationType"
        />
        <programRunner implementation="com.sickworm.intellij.jugg.ide.JuggDebugProgramRunner"/>
        <runLineMarkerContributor
                language="JAVA"
                implementationClass="com.sickworm.intellij.jugg.ide.JuggAndroidTestLineMarkerContributor"
        />
        <runLineMarkerContributor
                language="kotlin"
                implementationClass="com.sickworm.intellij.jugg.ide.JuggAndroidTestLineMarkerContributor"
        />
        <notificationGroup id="Jugg Important Notification"
                           displayType="STICKY_BALLOON"
                           key="notification.group.name"/>
        <notificationGroup id="Jugg Notification"
                           displayType="BALLOON"
                           key="notification.group.name"/>
        <toolWindow id="Jugg Running Pannel"
                    anchor="right"
                    icon="/res/icons/run_configuration.svg"
                    factoryClass="com.sickworm.intellij.jugg.ide.ui.JuggToolWindowFactory"/>
    </extensions>
    <actions>
        <action id="jugg.OpenControlPanelAction"
                class="com.sickworm.intellij.jugg.ide.ui.OpenJuggControlPanelAction"
                text="Open Jugg Control Panel"
                description="Open the Jugg project control panel"
                icon="/res/icons/run_configuration.svg">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="jugg.RestartAppAction"
                class="com.sickworm.intellij.jugg.ide.ui.RestartAppAction"
                text="Restart App"
                description="Restart App for selected devices"
                icon="AllIcons.Actions.Refresh"
        >
            <add-to-group group-id="RunMenu" anchor="last"/> <!-- menu -->
            <add-to-group group-id="ToolbarRunGroup" anchor="last"/> <!-- old ui -->
            <add-to-group group-id="MainToolbarRight" anchor="first"/> <!-- new ui -->
        </action>

        <action id="jugg.GradleCompileAction"
                class="com.sickworm.intellij.jugg.ide.ui.GradleCompileAction"
                text="(Jugg) Fallback to Gradle Compile"
                description="(Jugg) Fallback to Gradle Compile"
                icon="/res/icons/fallback.svg"
        >
            <add-to-group group-id="RunMenu" anchor="last"/> <!-- menu -->
            <add-to-group group-id="ToolbarRunGroup" anchor="last"/> <!-- old ui -->
            <add-to-group group-id="MainToolbarRight" anchor="first"/> <!-- new ui -->
        </action>

        <action id="jugg.ReportIssueAction"
                class="com.sickworm.intellij.jugg.ide.ui.ReportIssueAction"
                text="Report Jugg Issue"
                description="Report Jugg Issue"
                icon="/res/icons/run_configuration.svg"
        >
        </action>

        <action id="jugg.InstallSkillAction"
                class="com.sickworm.intellij.jugg.ide.ui.InstallSkillAction"
                text="Install Jugg Skills"
                description="Install Jugg skills for AI clients (Codex / Claude Code / Gemini)"
        >
        </action>

        <action id="jugg.CheckJuggUpdateAction"
                class="com.sickworm.intellij.jugg.ide.ui.CheckJuggUpdateAction"
                text="Check Jugg Update"
                description="Check Jugg Update"
        >
        </action>
    </actions>
</idea-plugin>
