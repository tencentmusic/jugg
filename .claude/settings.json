{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/guard-jugg-edit.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/pre-edit-tdd-check.sh"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/guard-jugg-edit.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/pre-edit-tdd-check.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/mark-jugg-docs-read.sh"
          }
        ]
      }
    ]
  }
}
