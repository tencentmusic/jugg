    {
      "id": "quick_action_height",
      "question": "Should Swing use a fixed 52px normalized height or equal native preferred heights with a 48px minimum?",
      "decision": "Use equal native preferred heights with a 48px minimum; do not encode the browser-specific 51.34px value."
    },
    {
      "id": "logs_vertical_overflow",
      "question": "Should the 4px HTML overflow be reproduced?",
      "decision": "No. Swing should use BorderLayout so the console fills the exact remaining height."
    },
