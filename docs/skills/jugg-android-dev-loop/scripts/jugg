#!/usr/bin/env bash
# jugg — Jugg CLI main entry point
# Dispatches to subcommand handlers that wrap Jugg MCP tools.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=_lib/_lib.sh
source "$SCRIPT_DIR/_lib/_lib.sh"

_usage() {
  cat <<'EOF'
Usage: jugg <subcommand> [options]

Subcommands:
  screenshot          Capture a device screenshot
  crash-report        Collect latest app crash report
  compile             Compile modified sources (no deploy)
  deploy              Compile and deploy to device (waits for completion)
  gradle-build        Force Gradle build (waits for completion)
  reinstall           Clear app data and reinstall APK
  restart             Restart the app
  record-start        Start screen recording
  record-stop         Stop screen recording and output mp4 path
  layout-dump         Export UI hierarchy to HTML file
  view-locate         Find a UI element's position and bounds
  view-inspect        Evaluate getter expressions on a View element
  tap                 Perform tap/long-press/swipe on device
  devices             List connected devices
  activity-stack      Show current Activity stack
  ssh-info            Request remote SSH troubleshooting info

Run 'jugg <subcommand> --help' for subcommand options.
EOF
  exit 1
}

if [[ $# -eq 0 ]]; then
  _usage
fi

SUBCOMMAND="$1"
shift

case "$SUBCOMMAND" in
  screenshot)      source "$SCRIPT_DIR/../_lib/screenshot.sh";      cmd_screenshot      "$@" ;;
  crash-report)    source "$SCRIPT_DIR/../_lib/crash-report.sh";    cmd_crash_report    "$@" ;;
  compile)         source "$SCRIPT_DIR/../_lib/compile.sh";         cmd_compile         "$@" ;;
  deploy)          source "$SCRIPT_DIR/../_lib/deploy.sh";          cmd_deploy          "$@" ;;
  gradle-build)    source "$SCRIPT_DIR/../_lib/gradle-build.sh";    cmd_gradle_build    "$@" ;;
  reinstall)       source "$SCRIPT_DIR/../_lib/reinstall.sh";       cmd_reinstall       "$@" ;;
  restart)         source "$SCRIPT_DIR/../_lib/restart.sh";         cmd_restart         "$@" ;;
  record-start)    source "$SCRIPT_DIR/../_lib/record-start.sh";    cmd_record_start    "$@" ;;
  record-stop)     source "$SCRIPT_DIR/../_lib/record-stop.sh";     cmd_record_stop     "$@" ;;
  layout-dump)     source "$SCRIPT_DIR/../_lib/layout-dump.sh";     cmd_layout_dump     "$@" ;;
  view-locate)     source "$SCRIPT_DIR/../_lib/view-locate.sh";     cmd_view_locate     "$@" ;;
  view-inspect)    source "$SCRIPT_DIR/../_lib/view-inspect.sh";    cmd_view_inspect    "$@" ;;
  tap)             source "$SCRIPT_DIR/../_lib/tap.sh";             cmd_tap             "$@" ;;
  devices)         source "$SCRIPT_DIR/../_lib/devices.sh";         cmd_devices         "$@" ;;
  activity-stack)  source "$SCRIPT_DIR/../_lib/activity-stack.sh";  cmd_activity_stack  "$@" ;;
  ssh-info)        source "$SCRIPT_DIR/../_lib/ssh-info.sh";        cmd_ssh_info        "$@" ;;
  --help|-h|help)  _usage ;;
  *)
    echo "jugg: unknown subcommand '$SUBCOMMAND'" >&2
    echo "Run 'jugg' for a list of available subcommands." >&2
    exit 1
    ;;
esac
