#!/usr/bin/env bash
# jugg — macOS/Linux wrapper for Jugg CLI (Python version)
# Place this in PATH or call directly: jugg compile --console=json

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
if command -v python3 >/dev/null 2>&1; then
  PYTHON=python3
elif command -v python >/dev/null 2>&1; then
  PYTHON=python
else
  echo "jugg: Python 3.7+ was not found. Install Python or add python3/python to PATH." >&2
  exit 127
fi

exec "$PYTHON" "$SCRIPT_DIR/jugg.py" --console=rich "$@"
