<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        tools:context=".MainActivity">

    <TextView
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hello World Jugg!"
            android:layout_marginTop="32dp"/>

    <Button
            android:id="@+id/button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MainActivity2"
            android:layout_marginTop="16dp"
    />

    <Button
            android:id="@+id/btn_moshi_demo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Moshi KSP Demo"
            android:layout_marginTop="16dp"
    />

    <Button
            android:id="@+id/btn_java_databinding_demo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Java Data Binding Demo"
            android:layout_marginTop="16dp"
    />


    <Button
            android:id="@+id/btn_kotlin_databinding_demo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kotlin Data Binding Demo"
            android:layout_marginTop="16dp"
    />

    <Button
            android:id="@+id/btn_mcp_test_page"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MCP Test Page"
            android:layout_marginTop="16dp"
    />
</LinearLayout>
