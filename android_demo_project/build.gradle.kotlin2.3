// Top-level build file where you can add configuration options common to all sub-projects/modules.

buildscript {
    ext.kotlin_version = project.findProperty('kotlinVersion') ?: '2.3.20'
    ext.agp_version = project.findProperty('agpVersion') ?: '8.13.2'
    ext.ksp_version = project.findProperty('kspVersion') ?: '2.3.9'
    ext.compose_version = project.findProperty('composeVersion') ?: '1.10.3'

    repositories {
        google()
        mavenCentral()

    }
    dependencies {
        classpath "com.android.tools.build:gradle:$agp_version"
        classpath "org.jetbrains.kotlin:kotlin-gradle-plugin:$kotlin_version"
        classpath "org.jetbrains.kotlin:compose-compiler-gradle-plugin:$kotlin_version"
        // NOTE: Do not place your application dependencies here; they belong
        // in the individual module build.gradle files
    }
}

plugins {
    id 'com.google.devtools.ksp' version "$ksp_version" apply false
    id 'org.jetbrains.kotlin.plugin.compose' version "$kotlin_version" apply false
    id 'org.jetbrains.compose' version "$compose_version" apply false
}

allprojects {
    layout.buildDirectory.set(rootProject.layout.projectDirectory.dir("build/${project.name}"))

    repositories {
        google()
        mavenCentral()
        jcenter()

    }
}

task clean(type: Delete) {
    delete rootProject.buildDir
}
