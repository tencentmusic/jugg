// Top-level build file where you can add configuration options common to all sub-projects/modules.

buildscript {
    ext.kotlin_version = project.findProperty('kotlinVersion') ?: '1.7.21'
    ext.agp_version = project.findProperty('agpVersion') ?: '7.2.2'
    ext.ksp_version = project.findProperty('kspVersion') ?: '1.7.21-1.0.8'

    repositories {
        google()
        mavenCentral()
    }
    dependencies {
        classpath "com.android.tools.build:gradle:$agp_version"
        classpath "org.jetbrains.kotlin:kotlin-gradle-plugin:$kotlin_version"
    }
}

plugins {
    id 'com.google.devtools.ksp' version "$ksp_version" apply false
}

allprojects {
    layout.buildDirectory.set(rootProject.layout.projectDirectory.dir("build/${project.name}"))

    repositories {
        google()
        mavenCentral()
        jcenter()
    }
}

task clean(type: Delete) {
    delete rootProject.buildDir
}
