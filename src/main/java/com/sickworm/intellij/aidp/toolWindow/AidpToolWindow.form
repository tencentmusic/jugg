<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.sickworm.intellij.aidp.toolWindow.AidpToolWindow">
  <grid id="27dc6" binding="myToolWindowContent" layout-manager="GridLayoutManager" row-count="2" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="723" height="441"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="9aa3f" class="javax.swing.JLabel" binding="currentDate">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <icon value="toolWindow/Calendar-icon.png"/>
          <text value="Date"/>
        </properties>
      </component>
      <component id="44be3" class="javax.swing.JLabel" binding="timeZone">
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <icon value="toolWindow/Time-zone-icon.png"/>
          <text value="TimeZone"/>
        </properties>
      </component>
      <component id="f02af" class="javax.swing.JLabel" binding="currentTime">
        <constraints>
          <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <icon value="toolWindow/Time-icon.png"/>
          <text value="Time"/>
        </properties>
      </component>
      <component id="5fceb" class="javax.swing.JButton" binding="applyButton">
        <constraints>
          <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text value="Apply"/>
        </properties>
      </component>
      <scrollpane id="931ca">
        <constraints>
          <grid row="0" column="3" row-span="2" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="2" use-parent-layout="false"/>
        </constraints>
        <properties>
          <enabled value="false"/>
          <horizontalScrollBarPolicy value="30"/>
        </properties>
        <border type="none"/>
        <children>
          <component id="bb2de" class="javax.swing.JTextPane" binding="runningLog">
            <constraints/>
            <properties>
              <font name="Consolas" size="14"/>
            </properties>
          </component>
        </children>
      </scrollpane>
    </children>
  </grid>
</form>
