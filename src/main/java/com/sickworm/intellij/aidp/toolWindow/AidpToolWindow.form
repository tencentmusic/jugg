<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.sickworm.intellij.aidp.toolWindow.AidpToolWindow">
  <grid id="27dc6" binding="myToolWindowContent" layout-manager="GridLayoutManager" row-count="4" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="723" height="441"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <scrollpane id="931ca">
        <constraints>
          <grid row="0" column="2" row-span="4" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <background color="-13948117"/>
          <enabled value="false"/>
          <horizontalScrollBarPolicy value="30"/>
        </properties>
        <border type="empty">
          <size top="0" left="8" bottom="0" right="8"/>
        </border>
        <children>
          <component id="bb2de" class="javax.swing.JTextPane" binding="runningLog">
            <constraints/>
            <properties>
              <background color="-13948117"/>
              <font name="JetBrains Mono" size="13"/>
            </properties>
            <clientProperties>
              <JEditorPane.w3cLengthUnits class="java.lang.Boolean" value="false"/>
            </clientProperties>
          </component>
        </children>
      </scrollpane>
      <grid id="31407" layout-manager="GridLayoutManager" row-count="8" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="8" bottom="0" right="8"/>
        <constraints>
          <grid row="0" column="1" row-span="4" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="be15b" class="javax.swing.JCheckBox" binding="deployOnSaveCheckBox">
            <constraints>
              <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Deploy when file saved"/>
            </properties>
          </component>
          <vspacer id="eb56a">
            <constraints>
              <grid row="5" column="0" row-span="1" col-span="1" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false"/>
            </constraints>
          </vspacer>
          <component id="5fceb" class="javax.swing.JButton" binding="deployButton">
            <constraints>
              <grid row="6" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Deploy"/>
            </properties>
          </component>
          <vspacer id="6b6e4">
            <constraints>
              <grid row="7" column="0" row-span="1" col-span="1" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false"/>
            </constraints>
          </vspacer>
          <vspacer id="b8c71">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="6" hsize-policy="1" anchor="0" fill="2" indent="0" use-parent-layout="false"/>
            </constraints>
          </vspacer>
          <component id="80f1d" class="javax.swing.JCheckBox" binding="enableDebugLogCheckBox">
            <constraints>
              <grid row="4" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Enable debug log"/>
            </properties>
          </component>
          <component id="13a3a" class="javax.swing.JLabel" binding="statusLabel">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Label"/>
